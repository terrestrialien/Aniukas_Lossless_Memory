{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:alm:conformance:cases:1",
  "title": "ALM portable conformance cases",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "cases"],
  "properties": {
    "version": {"const": 1},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "file": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "pointer": {"type": "string", "pattern": "^/"},
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "source_test", "operations", "expect"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "description": {"type": "string", "minLength": 1},
        "source_test": {"type": "string", "pattern": "^test_[a-z0-9_]+$"},
        "operations": {"type": "array", "items": {"$ref": "#/$defs/operation"}},
        "assertions": {"type": "array", "items": {"$ref": "#/$defs/assertion"}},
        "compare_baseline": {"type": "boolean"},
        "expect": {"oneOf": [{"$ref": "#/$defs/valid"}, {"$ref": "#/$defs/error"}]}
      }
    },
    "valid": {
      "type": "object", "additionalProperties": false,
      "required": ["result"], "properties": {"result": {"const": "valid"}}
    },
    "error": {
      "type": "object", "additionalProperties": false,
      "required": ["result", "error_code", "diagnostic_contains"],
      "properties": {
        "result": {"const": "error"},
        "error_code": {"type": "string", "pattern": "^[A-Z_]+$"},
        "diagnostic_contains": {"type": "string", "minLength": 1}
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op"],
      "properties": {
        "op": {"enum": ["set", "remove", "append", "copy_file", "delete_file", "replace_utf8", "repeat_byte", "lf_to_crlf", "recompute"]},
        "file": {"$ref": "#/$defs/file"},
        "pointer": {"$ref": "#/$defs/pointer"},
        "line": {"type": "integer", "minimum": 0},
        "value": {},
        "from": {"$ref": "#/$defs/file"},
        "to": {"$ref": "#/$defs/file"},
        "old": {"type": "string", "minLength": 1},
        "new": {"type": "string"},
        "count": {"type": "integer", "minimum": 0},
        "byte": {"type": "integer", "minimum": 0, "maximum": 255},
        "kind": {"enum": ["commit_digest", "revision_snapshot", "chunk_digest"]},
        "index": {"type": "integer", "minimum": 0}
      },
      "allOf": [
        {"if": {"properties": {"op": {"enum": ["set", "append"]}}, "required": ["op"]}, "then": {"required": ["file", "pointer", "value"]}},
        {"if": {"properties": {"op": {"const": "remove"}}, "required": ["op"]}, "then": {"required": ["file", "pointer"]}},
        {"if": {"properties": {"op": {"const": "copy_file"}}, "required": ["op"]}, "then": {"required": ["from", "to"]}},
        {"if": {"properties": {"op": {"enum": ["delete_file", "lf_to_crlf"]}}, "required": ["op"]}, "then": {"required": ["file"]}},
        {"if": {"properties": {"op": {"const": "replace_utf8"}}, "required": ["op"]}, "then": {"required": ["file", "old", "new"]}},
        {"if": {"properties": {"op": {"const": "repeat_byte"}}, "required": ["op"]}, "then": {"required": ["file", "byte", "count"]}},
        {"if": {"properties": {"op": {"const": "recompute"}}, "required": ["op"]}, "then": {"required": ["file", "kind"]}}
      ]
    },
    "assertion": {
      "type": "object", "additionalProperties": false,
      "required": ["op"],
      "properties": {
        "op": {"enum": ["equals", "length", "generated_bytes_match", "source_byte_selectors_match"]},
        "file": {"$ref": "#/$defs/file"},
        "pointer": {"$ref": "#/$defs/pointer"},
        "line": {"type": "integer", "minimum": 0},
        "value": {},
        "source_file": {"$ref": "#/$defs/file"},
        "message_count": {"type": "integer", "minimum": 1},
        "roles": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "reason_phrases": {"type": "array", "items": {"type": "string"}}
      },
      "allOf": [
        {"if": {"properties": {"op": {"enum": ["equals", "length"]}}, "required": ["op"]}, "then": {"required": ["file", "pointer", "value"]}},
        {"if": {"properties": {"op": {"const": "source_byte_selectors_match"}}, "required": ["op"]}, "then": {"required": ["file", "source_file", "message_count", "roles", "reason_phrases"]}}
      ]
    }
  }
}
