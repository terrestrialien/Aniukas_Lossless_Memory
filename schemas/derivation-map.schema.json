{
  "$id": "urn:aniukas-lossless-memory:format:1:derivation-map",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "count_filter": {
      "const": "registered children whose current status is not superseded"
    },
    "entries": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "base_revision_id": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{1,127}$",
            "type": "string"
          },
          "child_id": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{1,127}$",
            "type": "string"
          },
          "child_revision_id": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{1,127}$",
            "type": "string"
          },
          "child_scope_id": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{1,127}$",
            "type": "string"
          },
          "derivative_kind": {
            "enum": [
              "exception",
              "specialization",
              "extension",
              "restriction",
              "override",
              "combination"
            ]
          },
          "reason": {
            "minLength": 1,
            "type": "string"
          },
          "registered_in": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{1,127}$",
            "type": "string"
          },
          "summary": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "child_id",
          "child_scope_id",
          "child_revision_id",
          "base_revision_id",
          "derivative_kind",
          "summary",
          "reason",
          "registered_in"
        ],
        "type": "object"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "extensions": {
      "propertyNames": {
        "pattern": "^[a-z0-9]+[.][a-z0-9_.-]+$"
      },
      "type": "object"
    },
    "format_version": {
      "const": "1"
    },
    "generation": {
      "minimum": 1,
      "type": "integer"
    },
    "id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{1,127}$",
      "type": "string"
    },
    "instance_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{1,127}$",
      "type": "string"
    },
    "kind": {
      "const": "derivation-map"
    },
    "parent_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{1,127}$",
      "type": "string"
    },
    "registered_count": {
      "minimum": 0,
      "type": "integer"
    },
    "scope_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{1,127}$",
      "type": "string"
    },
    "updated_in": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{1,127}$",
      "type": "string"
    },
    "watermark": {
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "format_version",
    "instance_id",
    "kind",
    "id",
    "scope_id",
    "parent_id",
    "generation",
    "watermark",
    "registered_count",
    "count_filter",
    "entries",
    "updated_in"
  ],
  "title": "Aniukas Lossless Memory profile 1: derivation-map",
  "type": "object"
}
