{
  "$id": "urn:aniukas-lossless-memory:format:1:candidate",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assertion": {
      "additionalProperties": false,
      "properties": {
        "adoption_evidence": {
          "items": {
            "pattern": "^win://[A-Za-z][A-Za-z0-9_.:-]{1,127}$",
            "type": "string"
          },
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        },
        "asserted_by": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{1,127}$",
          "type": "string"
        },
        "kind": {
          "enum": [
            "user-stated",
            "AI-inferred",
            "document",
            "external-source",
            "system-observed"
          ]
        },
        "reliability_note": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "asserted_by",
        "kind",
        "adoption_evidence",
        "reliability_note"
      ],
      "type": "object"
    },
    "candidate_statement": {
      "minLength": 1,
      "type": "string"
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "confidence_basis": {
      "minLength": 1,
      "type": "string"
    },
    "created_in": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{1,127}$",
      "type": "string"
    },
    "event_types": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "extensions": {
      "propertyNames": {
        "pattern": "^[a-z0-9]+[.][a-z0-9_.-]+$"
      },
      "type": "object"
    },
    "format_version": {
      "const": "1"
    },
    "id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{1,127}$",
      "type": "string"
    },
    "instance_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{1,127}$",
      "type": "string"
    },
    "kind": {
      "const": "candidate"
    },
    "resolution_record_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{1,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "scope_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{1,127}$",
      "type": "string"
    },
    "source_refs": {
      "items": {
        "pattern": "^(mem|rev|win|log|map|proposal|candidate|conflict|commit|review|outbox|audit)://[A-Za-z][A-Za-z0-9_.:-]{1,127}(?:/m[1-9][0-9]*(?:-[1-9][0-9]*)?)?$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "state": {
      "enum": [
        "open",
        "needs-review",
        "confirmed",
        "rejected",
        "deferred",
        "exploratory",
        "expired",
        "superseded"
      ]
    },
    "state_history": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "commit_id": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{1,127}$",
            "type": "string"
          },
          "reason": {
            "minLength": 1,
            "type": "string"
          },
          "state": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "state",
          "reason",
          "commit_id"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "subject": {
      "minLength": 1,
      "type": "string"
    },
    "updated_in": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{1,127}$",
      "type": "string"
    }
  },
  "required": [
    "format_version",
    "instance_id",
    "kind",
    "id",
    "scope_id",
    "event_types",
    "subject",
    "candidate_statement",
    "assertion",
    "confidence",
    "confidence_basis",
    "source_refs",
    "state",
    "state_history",
    "resolution_record_id",
    "created_in",
    "updated_in"
  ],
  "title": "Aniukas Lossless Memory profile 1: candidate",
  "type": "object"
}
