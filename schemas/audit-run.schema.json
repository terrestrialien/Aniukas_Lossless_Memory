{
  "$id": "urn:aniukas-lossless-memory:format:1:audit-run",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "auditor_principal_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{1,127}$",
      "type": "string"
    },
    "auditor_version": {
      "minLength": 1,
      "type": "string"
    },
    "checkpoint": {
      "minimum": 1,
      "type": "integer"
    },
    "created_in": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{1,127}$",
      "type": "string"
    },
    "extensions": {
      "propertyNames": {
        "pattern": "^[a-z0-9]+[.][a-z0-9_.-]+$"
      },
      "type": "object"
    },
    "findings": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "format_version": {
      "const": "1"
    },
    "id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{1,127}$",
      "type": "string"
    },
    "instance_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{1,127}$",
      "type": "string"
    },
    "kind": {
      "const": "audit-run"
    },
    "message_end": {
      "minimum": 1,
      "type": "integer"
    },
    "message_start": {
      "minimum": 1,
      "type": "integer"
    },
    "repair_proposal_refs": {
      "items": {
        "pattern": "^(mem|rev|win|log|map|proposal|candidate|conflict|commit|review|outbox|audit)://[A-Za-z][A-Za-z0-9_.:-]{1,127}(?:/m[1-9][0-9]*(?:-[1-9][0-9]*)?)?$",
        "type": "string"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "scope_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{1,127}$",
      "type": "string"
    },
    "source_log_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{1,127}$",
      "type": "string"
    }
  },
  "required": [
    "format_version",
    "instance_id",
    "kind",
    "id",
    "scope_id",
    "auditor_principal_id",
    "source_log_id",
    "message_start",
    "message_end",
    "auditor_version",
    "checkpoint",
    "findings",
    "repair_proposal_refs",
    "created_in"
  ],
  "title": "Aniukas Lossless Memory profile 1: audit-run",
  "type": "object"
}
