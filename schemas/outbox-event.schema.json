{
  "$id": "urn:aniukas-lossless-memory:format:1:outbox-event",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "ack_commit_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{1,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "attempts": {
      "minimum": 0,
      "type": "integer"
    },
    "delivery_history": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "commit_id": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{1,127}$",
            "type": "string"
          },
          "reason": {
            "minLength": 1,
            "type": "string"
          },
          "state": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "state",
          "reason",
          "commit_id"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "delivery_state": {
      "enum": [
        "pending",
        "delivered",
        "rejected"
      ]
    },
    "event_type": {
      "enum": [
        "register-derivation",
        "refresh-derivation",
        "retire-derivation",
        "promotion-accepted",
        "parent-updated",
        "repair-proposed"
      ]
    },
    "extensions": {
      "propertyNames": {
        "pattern": "^[a-z0-9]+[.][a-z0-9_.-]+$"
      },
      "type": "object"
    },
    "format_version": {
      "const": "1"
    },
    "id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{1,127}$",
      "type": "string"
    },
    "instance_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{1,127}$",
      "type": "string"
    },
    "kind": {
      "const": "outbox-event"
    },
    "payload_refs": {
      "items": {
        "pattern": "^(mem|rev|win|log|map|proposal|candidate|conflict|commit|review|outbox|audit)://[A-Za-z][A-Za-z0-9_.:-]{1,127}(?:/m[1-9][0-9]*(?:-[1-9][0-9]*)?)?$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "scope_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{1,127}$",
      "type": "string"
    },
    "source_commit_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{1,127}$",
      "type": "string"
    },
    "target_scope_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{1,127}$",
      "type": "string"
    }
  },
  "required": [
    "format_version",
    "instance_id",
    "kind",
    "id",
    "scope_id",
    "source_commit_id",
    "target_scope_id",
    "event_type",
    "payload_refs",
    "delivery_state",
    "delivery_history",
    "ack_commit_id",
    "attempts"
  ],
  "title": "Aniukas Lossless Memory profile 1: outbox-event",
  "type": "object"
}
